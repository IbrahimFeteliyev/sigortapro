# Public origin of the site, without a trailing slash.
# Required for production: used for canonical URLs, hreflang, sitemap.xml,
# robots.txt, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.az

# Phase 2 (optional): base URL of the Spring Boot REST API.
# Leave empty to run on mock data with the application form in demo mode.
NEXT_PUBLIC_API_BASE_URL=
